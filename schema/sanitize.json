{
  "schema": 1,
  "note": [
    "入包文本文件(.html/.css/.js/.json/.md)的公开前替换表,由 scripts/sanitize.py 执行(scripts/build_pack.py 默认调用)。",
    "每条规则:id(稳定标识,用于按规则汇总计数)/ pattern(Python re,逐文件全文替换)/ replace(支持 \\1 反向引用与 ${tagline} ${tagline_short} 占位符)/ why(为什么这条必须替换)/ scope(生效扩展名)。",
    "replace 结果必须保持文件可解析(不引入未转义引号或换行),所以 .json 里被替换的串仍是合法字符串值。",
    "禁止静默改写:每处替换都要计数,并按包打印 规则 × 次数 × 示例(sanitize.py --verbose 逐处打印 文件:行)。"
  ],
  "scope_include": [
    "html",
    "css",
    "js",
    "json",
    "md"
  ],
  "skip_filenames": [
    "MANIFEST.json"
  ],
  "taglines": {
    "abyss-lab-record": {
      "tagline": "暗场实验记录。观测 · 复现 · 归档。",
      "tagline_short": "暗场实验记录。"
    },
    "paper-editorial": {
      "tagline": "纸上编辑。长文 · 纸底 · 克制强调。",
      "tagline_short": "纸上编辑。"
    },
    "saaaai-paper": {
      "tagline": "暖纸阅读。文字优先 · 陶土点缀。",
      "tagline_short": "暖纸阅读。"
    },
    "saaaai-mono": {
      "tagline": "极简黑白。结构排版 · 高对比。",
      "tagline_short": "极简黑白。"
    },
    "fm-void": {
      "tagline": "纯黑舞台。留白即内容。",
      "tagline_short": "纯黑舞台。"
    },
    "mohe-mono-blue": {
      "tagline": "深青档案。长文 · 低调群青。",
      "tagline_short": "深青档案。"
    },
    "popart-neubrutal": {
      "tagline": "粗野拼贴。高饱和平涂 · 硬边。",
      "tagline_short": "粗野拼贴。"
    },
    "tokyo-crime-dark": {
      "tagline": "夜巡数据图。暖暗底 · 橙红刻度。",
      "tagline_short": "夜巡数据图。"
    },
    "slow-ride-cream": {
      "tagline": "奶油骑行志。柔和暖底 · 自然色。",
      "tagline_short": "奶油骑行志。"
    },
    "minimalist-essential": {
      "tagline": "极简必要件。少即是够。",
      "tagline_short": "极简必要件。"
    },
    "swiss-classic": {
      "tagline": "瑞士国际主义。网格 · 结构红。",
      "tagline_short": "瑞士国际主义。"
    },
    "swiss-inverted": {
      "tagline": "瑞士国际主义(反色)。深底 · 同一网格。",
      "tagline_short": "瑞士国际主义。"
    },
    "*": {
      "tagline": "主题演示页。结构 · 排版 · 组件。",
      "tagline_short": "主题演示页。"
    }
  },
  "rules": [
    {
      "id": "abs-path-home-users",
      "pattern": "(?<![A-Za-z0-9])[A-Za-z]:[\\\\/]Users[\\\\/][^]\\s\\\"'`<>|(),;]+",
      "replace": "[本机路径已移除]",
      "why": "本机用户目录路径会暴露开发机用户名与私有目录结构。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "abs-path-drive",
      "pattern": "(?<![A-Za-z0-9])[A-Za-z]:[\\\\/][^]\\s\\\"'`<>|(),;]+",
      "replace": "[本地路径已移除]",
      "why": "本机绝对路径(项目盘/素材盘)属于私有目录结构,公开后等于贴出本机布局。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "abs-path-unc",
      "pattern": "\\\\\\\\[^]\\s\\\"'`<>|(),;]+",
      "replace": "[本地路径已移除]",
      "why": "UNC 网络共享路径指向私有网络。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "abs-path-unix-home",
      "pattern": "(?<=[\\s(])/(?:Users|home)/[^]\\s\\\"'`<>|(),;]+",
      "replace": "[本机路径已移除]",
      "why": "类 Unix 家目录路径同上,暴露用户名。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "biz-domain",
      "pattern": "biz[.]saaaai[.]com",
      "replace": "内部商业档案站(已脱敏)",
      "why": "自有业务域名:公开资产库不该指向私有业务端点。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "loopback-dev-port",
      "pattern": "127[.]0[.]0[.]1:8\\d{1,4}",
      "replace": "本地开发地址(已脱敏)",
      "why": "本机服务端口(本地代理/网关)属于内网拓扑信息,与资产库无关。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "loopback-host",
      "pattern": "\\b(?:127[.]0[.]0[.]1|localhost):\\d{2,5}\\b",
      "replace": "本地开发地址(已脱敏)",
      "why": "任何回环地址+端口都只在单机成立,公开即成死链。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "private-ip",
      "pattern": "\\b(?:10\\.\\d{1,3}|192\\.168\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01]))\\.\\d{1,3}\\.\\d{1,3}\\b",
      "replace": "内网地址(已脱敏)",
      "why": "内网 IPv4 地址等于把私有网络拓扑贴到公网。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "template-tagline",
      "pattern": "AI\\s*安全\\s*[·・]\\s*研究\\s*[·・]\\s*人类进步。?",
      "replace": "${tagline}",
      "why": "主题原子里残留的他人品牌 tagline,不是本主题文案;换成该主题自己的中性 tagline。",
      "scope": [
        "html",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "template-tagline-short",
      "pattern": "AI\\s*安全即人类进步。?",
      "replace": "${tagline_short}",
      "why": "同 template-tagline 的短变体(社媒 chip 文案),一并换成该主题 tagline。",
      "scope": [
        "html",
        "js",
        "json",
        "md"
      ]
    },
    {
      "id": "confidential-mark",
      "pattern": "PRIVATE\\s*&\\s*CONFIDENTIAL",
      "replace": "",
      "why": "内部/客户文档的保密标记:说明该文件来自客户交付物,整段内容都不该公开。",
      "scope": [
        "html",
        "css",
        "js",
        "json",
        "md"
      ]
    }
  ]
}
